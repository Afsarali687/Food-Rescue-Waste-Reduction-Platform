# MongoDB Connection Settings
# For local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/
# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Database Name (default: food_rescue_db)
MONGO_DB=food_rescue_db

# Timeout in milliseconds for server selection
MONGO_TIMEOUT_MS=2500

# Secret Key for session / flash messages (generate a random string for production)
SECRET_KEY=change-this-to-a-secure-random-secret
